+  if (next.currentSite && allowed.has(next.currentSite)) {
+    merged.currentSite = next.currentSite;
+  }
+
+  ['activity', 'clock', 'rota'].forEach((key) => {
+    if (next[key] !== undefined) merged[key] = next[key];
+  });
