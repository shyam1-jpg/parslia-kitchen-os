+'use strict';
+
+/**
+ * Server-side workspace mutations.
+ * Tenant identity always comes from the authenticated session — never from the client body.
+ */
+
+const ALLOWED_COLLECTIONS = new Set([
+  'sites', 'team', 'sensors', 'checklists', 'records', 'alerts', 'menus', 'labels', 'waste',
+  'recipes', 'activity', 'workflows', 'suppliers', 'training', 'incidents', 'maintenance',
+  'deliveries', 'assets', 'batches', 'cooling', 'phlogs', 'holding', 'allergens',
+  'rotaShifts', 'clockSessions', 'attendanceLog',
+]);
+
+const ALLOWED_SCALARS = new Set([
+  'currentSite', 'org', 'settings', 'menusMeta', 'recipeAiLocal',
+]);
+
+const FORBIDDEN_KEYS = new Set([
+  '_tenantId', '_isDemo', '_tenantPrivate', '_isPrivate', 'users', 'tokens',
+  'pass', 'password', 'passwordHash', 'subscriptions', 'registrations',
+]);
+
+const MAX_ARRAY_LEN = 5000;
+
+function clone(v) {
+  return JSON.parse(JSON.stringify(v));
+}
+
+/**
+ * Merge client workspace into the server tenant copy without trusting tenant IDs.
+ */
+function mergeWorkspaceState(prev, incoming) {
+  const base = clone(prev || {});
+  const src = incoming && typeof incoming === 'object' ? incoming : {};
+
+  Object.keys(src).forEach((key) => {
+    if (FORBIDDEN_KEYS.has(key)) return;
+    if (key.startsWith('_') && key !== '_updatedAt' && key !== '_updatedBy' && key !== '_pilotPackVersion') return;
+
+    if (ALLOWED_COLLECTIONS.has(key)) {
+      if (!Array.isArray(src[key])) return;
+      base[key] = src[key].slice(0, MAX_ARRAY_LEN).map((row) => {
+        if (!row || typeof row !== 'object') return row;
+        const clean = Object.assign({}, row);
+        delete clean._tenantId;
+        delete clean.tenantId;
+        delete clean.businessId;
+        delete clean.companyId;
+        return clean;
+      });
+      return;
+    }
+
+    if (ALLOWED_SCALARS.has(key)) {
+      if (key === 'org' && src.org && typeof src.org === 'object') {
+        base.org = Object.assign({}, base.org || {}, {
+          name: src.org.name,
+          legalName: src.org.legalName,
+          plan: src.org.plan,
+          address: src.org.address,
+          phone: src.org.phone,
+          email: src.org.email,
+        });
+      } else if (key === 'settings' && src.settings && typeof src.settings === 'object') {
+        base.settings = Object.assign({}, base.settings || {}, src.settings);
+        delete base.settings.openaiApiKey;
+        delete base.settings.stripeSecret;
+        delete base.settings.ingestKey;
+      } else {
+        base[key] = src[key];
+      }
+    }
+  });
+
+  // Re-assert server tenant metadata after merge
+  base._tenantId = prev._tenantId;
+  base._isDemo = !!prev._isDemo;
+  base._tenantPrivate = !!prev._tenantPrivate;
+  base._isPrivate = !!prev._isPrivate;
+  return base;
+}
+
+/**
+ * Scoped mutation — prefer this over full-state PUT.
+ * body: { op: 'upsert'|'remove'|'set', collection|path, id?, data?, value? }
+ */
+function applyScopedMutation(prev, body) {
+  const state = clone(prev || {});
+  const op = String((body && body.op) || '').toLowerCase();
+
+  if (op === 'set') {
+    const path = String((body && body.path) || '');
+    if (!ALLOWED_SCALARS.has(path)) {
+      return { ok: false, error: 'Path not allowed', code: 'forbidden_path' };
+    }
+    if (path === 'currentSite') {
+      const siteId = String((body && body.value) || '');
+      const ok = (state.sites || []).some((s) => s.id === siteId);
+      if (!ok) return { ok: false, error: 'Unknown site for this kitchen', code: 'invalid_site' };
+      state.currentSite = siteId;
+    } else if (path === 'org' && body.value && typeof body.value === 'object') {
+      state.org = Object.assign({}, state.org || {}, {
+        name: body.value.name,
+        legalName: body.value.legalName,
+        plan: body.value.plan,
+        address: body.value.address,
+        phone: body.value.phone,
+        email: body.value.email,
+      });
+    } else {
+      state[path] = body.value;
+    }
+  } else if (op === 'upsert' || op === 'remove') {
+    const collection = String((body && body.collection) || '');
+    if (!ALLOWED_COLLECTIONS.has(collection)) {
+      return { ok: false, error: 'Collection not allowed', code: 'forbidden_collection' };
+    }
+    if (!Array.isArray(state[collection])) state[collection] = [];
+    const id = body && body.id != null ? String(body.id) : '';
+    if (!id) return { ok: false, error: 'Record id required', code: 'id_required' };
+
+    if (op === 'remove') {
+      state[collection] = state[collection].filter((r) => String(r && r.id) !== id);
+    } else {
+      const data = body.data && typeof body.data === 'object' ? Object.assign({}, body.data) : {};
+      data.id = id;
+      delete data._tenantId;
+      delete data.tenantId;
+      delete data.businessId;
+      delete data.companyId;
+      // Bind site fields to sites that exist in this tenant when present
+      if (data.site || data.siteId) {
+        const sid = data.site || data.siteId;
+        const known = (state.sites || []).some((s) => s.id === sid);
+        if (!known) return { ok: false, error: 'Record site is outside your kitchen', code: 'site_forbidden' };
+      }
+      const idx = state[collection].findIndex((r) => String(r && r.id) === id);
+      if (idx >= 0) state[collection][idx] = Object.assign({}, state[collection][idx], data);
+      else {
+        if (state[collection].length >= MAX_ARRAY_LEN) {
+          return { ok: false, error: 'Collection limit reached', code: 'limit' };
+        }
+        state[collection].unshift(data);
+      }
+    }
+  } else {
+    return { ok: false, error: 'Unknown op — use upsert, remove, or set', code: 'bad_op' };
+  }
+
+  state._tenantId = prev._tenantId;
+  state._isDemo = !!prev._isDemo;
+  state._tenantPrivate = !!prev._tenantPrivate;
+  state._isPrivate = !!prev._isPrivate;
+  return { ok: true, state };
+}
+
+module.exports = {
+  ALLOWED_COLLECTIONS,
+  ALLOWED_SCALARS,
+  mergeWorkspaceState,
+  applyScopedMutation,
+};
