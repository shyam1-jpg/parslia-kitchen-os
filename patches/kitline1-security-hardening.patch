+function cspHeader(isProd) {
+  // Intentionally allows required CDN/Firebase/inline app scripts.
+  // Tighten further once nonce-based CSP is rolled out.
+  const script = [
+    "'self'", "'unsafe-inline'", "'unsafe-eval'",
+    'https://cdn.jsdelivr.net', 'https://cdn.tailwindcss.com',
+    'https://www.gstatic.com', 'https://*.googleapis.com',
+    'https://*.firebaseio.com', 'https://*.firebaseapp.com',
+    'https://js.stripe.com',
+  ].join(' ');
+  const connect = [
+    "'self'",
+    'https://api.stripe.com', 'https://*.googleapis.com',
+    'https://*.firebaseio.com', 'https://*.firebasedatabase.app',
+    'wss://*.firebaseio.com', 'https://identitytoolkit.googleapis.com',
+    'https://securetoken.googleapis.com', 'https://firestore.googleapis.com',
+  ].join(' ');
+  return [
+    "default-src 'self'",
+    `script-src ${script}`,
+    "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdn.tailwindcss.com",
+    "font-src 'self' https://fonts.gstatic.com data:",
+    "img-src 'self' data: blob: https:",
+    `connect-src ${connect}`,
+    "frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://*.firebaseapp.com",
+    "worker-src 'self' blob:",
+    "object-src 'none'",
+    "base-uri 'self'",
+    "form-action 'self'",
+    "frame-ancestors 'none'",
+  ].join('; ');
+}
+
+function securityHeaders(extra, opts) {
+  opts = opts || {};
+  const headers = {
     'X-Content-Type-Options': 'nosniff',
     'X-Frame-Options': 'DENY',
     'Referrer-Policy': 'strict-origin-when-cross-origin',
-    'Permissions-Policy': 'camera=(), microphone=(), geolocation=()',
+    'Permissions-Policy': 'camera=(self), microphone=(self), geolocation=(self)',
     'X-Robots-Tag': 'noindex, nofollow',
-  }, extra || {});
+    'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+    'Content-Security-Policy': cspHeader(!!opts.isProd),
+  };
+  if (opts.isProd) {
+    headers['Strict-Transport-Security'] = 'max-age=31536000; includeSubDomains; preload';
+  }
+  return Object.assign(headers, extra || {});
+}
+
+function publicError(err, isProd) {
+  const msg = (err && err.message) ? String(err.message) : String(err || 'Request failed');
+  if (!isProd) return msg;
+  // Never leak filesystem paths, SMTP diagnostics, or stack fragments in production
+  if (/[/\\]|smtp|ECONN|EAI_AGAIN|ENOTFOUND|Invalid login|at\s+\S+\s+\(/i.test(msg)) {
+    return 'Something went wrong. Please try again or contact support.';
+  }
+  return msg.slice(0, 200);
+}
+
+function redactUserRecord(user) {
+  if (!user || typeof user !== 'object') return user;
+  const out = Object.assign({}, user);
+  delete out.pass;
+  delete out.password;
+  delete out.passwordHash;
+  if (out.recipeAi && out.recipeAi.openaiKeyEnc) {
+    out.recipeAi = Object.assign({}, out.recipeAi, { openaiKeyEnc: '[redacted]' });
+  }
+  return out;
+}
+
+function redactUsersMap(users) {
+  const out = {};
+  Object.entries(users || {}).forEach(([email, user]) => {
+    out[email] = redactUserRecord(user);
+  });
+  return out;
 }
 
