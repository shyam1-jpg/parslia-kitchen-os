+function cleanAllergenInfoText(raw){
+  const t=(raw||"").trim();
+  if(!t) return DEFAULT_INFO;
+  if(looksLikeDishDump(t)) return DEFAULT_INFO;
+  if(/^contains\s*:?/im.test(t) && (t.match(/^contains\s*:?/gim)||[]).length>=1) return DEFAULT_INFO;
+  // Strip accidental CAPS dish blocks that slipped into the blurb
+  const lines=t.split(/\r?\n/);
+  const kept=[];
+  let skipping=false;
+  for(const line of lines){
+    const rawLine=line.trim();
+    const low=rawLine.toLowerCase();
+    const caps = (()=>{ const L=rawLine.replace(/[^a-zA-Z]/g,""); return L.length>=6 && rawLine===rawLine.toUpperCase() && /[A-Z]/.test(rawLine); })();
+    if(/^contains\s*:?/i.test(rawLine) || /^suitable\s+for\b/i.test(rawLine)){ skipping=true; continue; }
+    if(caps && !/allergen|dietary|information|menu\s*$/i.test(rawLine)){ skipping=true; continue; }
+    if(skipping){
+      if(!rawLine){ skipping=false; }
+      continue;
+    }
+    kept.push(line);
+  }
+  const out=kept.join("\n").trim();
+  if(!out || looksLikeDishDump(out)) return DEFAULT_INFO;
+  return out;
+}
+function sanitizeInfoText(saveIt){
