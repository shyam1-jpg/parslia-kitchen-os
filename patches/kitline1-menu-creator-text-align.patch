+function looksLikeDishDump(text){
+  const t=(text||"").trim();
+  if(!t) return false;
+  const lines=t.split(/\r?\n/).map(s=>s.trim()).filter(Boolean);
+  if(lines.length<2) return false;
+  const containsN=lines.filter(l=>/^contains\s*:?/i.test(l)).length;
+  const capsN=lines.filter(l=>{
+    const L=l.replace(/[^a-zA-Z]/g,"");
+    return L.length>=6 && l===l.toUpperCase() && /[A-Z]/.test(l);
+  }).length;
+  // dish dump if several Contains: lines or several CAPS dish names
+  return containsN>=1 || capsN>=2;
+}
