+function applyWordAlign(s){
+  const a = currentAlign();
+  const align = "text-align:"+a+";";
+  const stripPad = a!=="left";
+  const fix = (css)=>{
+    let out = (css||"").replace(/text-align\s*:\s*(left|center|right)\s*;?/gi, "");
+    out = align + out;
+    if(stripPad){
+      out = out.replace(/border-left\s*:[^;]+;?/gi, "").replace(/padding-left\s*:[^;]+;?/gi, "");
+    }
+    return out;
+  };
+  return Object.assign({}, s, {
+    title: fix(s.title),
+    logo: fix(s.logo),
+    dish: fix(s.dish),
+    desc: fix(s.desc),
+    allg: fix(s.allg),
+    diet: fix(s.diet)
+  });
+}
