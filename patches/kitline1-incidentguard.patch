+.clock-log-row:last-child { border-bottom: 0; }
+.clock-log-row__name { font-weight: 650; color: #134e4a; }
+.clock-log-row__time { font-variant-numeric: tabular-nums; color: #64748b; font-size: .75rem; font-weight: 600; }
+.clock-staff-card {
