+/* Kiteline IncidentGuard — incident / near-miss / CAPA / offline / media helpers */
+(function () {
+  const CATEGORIES = [
+    'Accident or injury', 'Burn, cut, slip or fall', 'Near miss', 'Unsafe condition',
+    'Allergen incident', 'Foreign object', 'Food contamination', 'Suspected food poisoning',
+    'Fridge or freezer failure', 'Cooking or hot-holding failure', 'Equipment breakdown',
+    'Pest sighting', 'Chemical spill', 'Fire or gas incident', 'Customer complaint',
+    'Supplier recall', 'Other',
+  ];
+  const STATUSES = [
+    'Reported', 'Manager Review', 'Investigation', 'Action Required',
+    'Awaiting Verification', 'Closed',
+  ];
+  const SEVERITIES = ['Low', 'Medium', 'High', 'Critical'];
+  const QR_LOCATIONS = [
+    { id: 'fridge', label: 'Fridge / freezer' },
+    { id: 'oven', label: 'Oven' },
+    { id: 'fryer', label: 'Fryer' },
+    { id: 'blast', label: 'Blast chiller' },
+    { id: 'dishwasher', label: 'Dishwasher' },
+    { id: 'dry_store', label: 'Dry store' },
+    { id: 'chemical', label: 'Chemical cupboard' },
+    { id: 'delivery', label: 'Delivery area' },
+    { id: 'section', label: 'Kitchen section' },
+    { id: 'noticeboard', label: 'Staff safety noticeboard' },
+  ];
+  const ACTION_STATUSES = ['Open', 'In progress', 'Awaiting verification', 'Completed'];
+  const OFFLINE_KEY = 'kiteline.ig.offlineQueue';
+  const AI_ALLOW_KEY = 'kiteline.ig.aiAllowance';
+
+  function nextRef(db) {
+    return 'IG-' + String(((db.incidents || []).length + 1)).padStart(4, '0');
+  }
+
+  function migrateStatus(s) {
+    if (!s) return 'Reported';
+    if (STATUSES.includes(s)) return s;
+    if (s === 'Open') return 'Reported';
+    if (s === 'In progress') return 'Action Required';
+    if (s === 'Closed') return 'Closed';
+    return 'Reported';
+  }
+
+  function normalize(inc) {
+    if (!inc || typeof inc !== 'object') return inc;
+    inc.status = migrateStatus(inc.status);
+    if (!inc.ref) inc.ref = 'IG-' + String((inc.id || '').replace(/\D/g, '').slice(-4) || '0000').padStart(4, '0');
+    if (!inc.category && inc.type) {
+      const map = {
+        Accident: 'Accident or injury', Complaint: 'Customer complaint', Pest: 'Pest sighting',
+        Equipment: 'Equipment breakdown', 'Food safety': 'Food contamination', Other: 'Other',
+      };
+      inc.category = map[inc.type] || inc.type;
+    }
+    if (!Array.isArray(inc.actions)) inc.actions = [];
+    if (!Array.isArray(inc.photos)) inc.photos = [];
+    if (!Array.isArray(inc.history)) inc.history = [];
+    if (!Array.isArray(inc.feedback)) inc.feedback = [];
+    if (!Array.isArray(inc.links)) inc.links = [];
+    if (!inc.investigation || typeof inc.investigation !== 'object') {
+      inc.investigation = {
+        immediateCause: '', contributing: '', rootCause: '', fiveWhys: '',
+        existingControls: '', failedControls: '', lessons: '', approvedBy: '', approvedAt: '',
+      };
+    }
+    if (inc.riddorFlag == null) inc.riddorFlag = false;
+    if (inc.dangerPresent == null) inc.dangerPresent = false;
+    return inc;
+  }
+
+  function ensureAll(db) {
+    if (!db || !Array.isArray(db.incidents)) return db;
+    db.incidents.forEach(normalize);
+    if (!Array.isArray(db.incidentQrCodes)) {
+      db.incidentQrCodes = QR_LOCATIONS.map((loc) => ({
+        id: 'iqr_' + loc.id, locationKey: loc.id, label: loc.label, siteId: db.currentSite || null,
+      }));
+    }
+    if (!db.incidentAi) db.incidentAi = { monthlyCap: 200, used: 0, period: '' };
+    const mk = new Date().toISOString().slice(0, 7);
+    if (db.incidentAi.period !== mk) {
+      db.incidentAi.period = mk;
+      db.incidentAi.used = 0;
+    }
+    return db;
+  }
+
+  function mayNeedRiddor(inc) {
+    const sev = String(inc.severity || '');
+    const cat = String(inc.category || inc.type || '').toLowerCase();
+    if ((sev === 'Critical' || sev === 'High') && /accident|injur|burn|cut|slip|fall|poison|fire|gas|chemical/.test(cat)) return true;
+    return !!inc.riddorFlag;
+  }
+
+  function openCount(db, site) {
+    return (db.incidents || []).filter((i) => (!site || i.site === site) && migrateStatus(i.status) !== 'Closed').length;
+  }
+
+  function overdueActions(db, site) {
+    const today = new Date().toISOString().slice(0, 10);
+    const out = [];
+    (db.incidents || []).forEach((inc) => {
+      if (site && inc.site !== site) return;
+      normalize(inc);
+      (inc.actions || []).forEach((a) => {
+        if (a.status !== 'Completed' && a.due && a.due < today) out.push({ incident: inc, action: a });
+      });
+    });
+    return out;
+  }
+
+  function dashboardStats(db, site) {
+    const list = (db.incidents || []).map(normalize).filter((i) => !site || i.site === site);
+    const byCat = {};
+    const byArea = {};
+    list.forEach((i) => {
+      byCat[i.category || 'Other'] = (byCat[i.category || 'Other'] || 0) + 1;
+      byArea[i.area || 'Unspecified'] = (byArea[i.area || 'Unspecified'] || 0) + 1;
+    });
+    const closed = list.filter((i) => i.status === 'Closed' && i.closedAt);
+    let avgHours = null;
+    if (closed.length) {
+      avgHours = Math.round(closed.reduce((a, i) => a + (new Date(i.closedAt) - new Date(i.at)), 0) / closed.length / 36e5);
+    }
+    return {
+      total: list.length,
+      open: list.filter((i) => i.status !== 'Closed').length,
+      critical: list.filter((i) => i.severity === 'Critical' || i.severity === 'High').length,
+      overdue: overdueActions(db, site).length,
+      allergen: list.filter((i) => /allergen/i.test(i.category || '')).length,
+      temperature: list.filter((i) => /fridge|freezer|temperature|hot-hold|cooking/i.test(i.category || '')).length,
+      nearMiss: list.filter((i) => /near miss/i.test(i.category || '')).length,
+      byCategory: byCat,
+      byArea,
+      avgHoursToClose: avgHours,
+    };
+  }
+
+  function createIncident(db, patch, byUserId) {
+    ensureAll(db);
+    const now = new Date().toISOString();
+    const inc = normalize(Object.assign({
+      id: (window.Store && window.Store.uid) ? window.Store.uid('inc') : ('inc_' + Date.now()),
+      ref: nextRef(db),
+      title: '', category: 'Near miss', type: 'Other', site: db.currentSite,
+      area: '', severity: 'Medium', description: '', dangerPresent: false,
+      immediateAction: '', action: '', peopleInvolved: '', witnesses: '', firstAid: '',
+      equipment: '', foodAffected: '', photoNote: '', voiceNote: '', voiceAudio: '',
+      photos: [], gps: null, reportedBy: byUserId || 'unknown', at: now, status: 'Reported',
+      actions: [], investigation: {}, history: [{ at: now, by: byUserId || 'unknown', note: 'Incident reported' }],
+      feedback: [], links: [], riddorFlag: false, qrLocation: '', source: 'app',
+    }, patch));
+    if (mayNeedRiddor(inc)) inc.riddorFlag = true;
+    db.incidents.unshift(inc);
+    return inc;
+  }
+
+  function addAction(inc, patch, byUserId) {
+    normalize(inc);
+    const a = Object.assign({
+      id: 'iga_' + Date.now().toString(36), ownerId: '', priority: 'Medium', due: '',
+      instructions: '', evidence: '', notes: '', status: 'Open', completedAt: '', verifiedBy: '',
+    }, patch);
+    inc.actions.push(a);
+    inc.status = 'Action Required';
+    inc.history.push({ at: new Date().toISOString(), by: byUserId || 'unknown', note: 'Corrective action added' });
+    return a;
+  }
+
+  function setStatus(inc, status, byUserId, note) {
+    normalize(inc);
+    const next = migrateStatus(status);
+    inc.status = next;
+    if (next === 'Closed') inc.closedAt = new Date().toISOString();
+    inc.history.push({ at: new Date().toISOString(), by: byUserId || 'unknown', note: note || ('Status → ' + next) });
+    return inc;
+  }
+
+  function addFeedback(inc, message, byUserId) {
