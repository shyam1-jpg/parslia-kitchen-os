+.clock-staff-pin {
+  margin-top: .7rem; padding: .4rem .55rem; border-radius: .65rem;
+  background: #f0fdfa; border: 1px dashed #99f6e4;
+  font-size: .72rem; font-weight: 600; color: #0f766e; text-align: center;
+  letter-spacing: .02em;
+}
+.clock-staff-pin b {
+  font-variant-numeric: tabular-nums; letter-spacing: .14em; color: #115e59; margin-left: .25rem;
+}
+.clock-result {
+  position: absolute; inset: 0; z-index: 5;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .65rem;
+  background: rgba(4,47,46,.88); backdrop-filter: blur(6px);
+  color: #ecfdf5; text-align: center; padding: 1.5rem;
+  opacity: 0; pointer-events: none; transition: opacity .2s;
+}
+.clock-result.is-show { opacity: 1; }
+.clock-result__mark {
+  width: 3.25rem; height: 3.25rem; border-radius: 999px;
+  display: flex; align-items: center; justify-content: center;
+  font-size: 1.4rem; font-weight: 800; color: #042f2e;
+  background: linear-gradient(135deg, #5eead4, #14b8a6);
