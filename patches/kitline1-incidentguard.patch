+/* ========== Premium Clock In / Out kiosk (Kiteline teal) ========== */
+.clock-shell {
+  --ck-ink: #042f2e;
+  --ck-panel: #0b1220;
+  --ck-panel-2: #115e59;
+  --ck-accent: #14b8a6;
+  --ck-accent-2: #2dd4bf;
+  --ck-glow: rgba(20,184,166,.35);
+  font-family: 'Sora', Inter, system-ui, sans-serif;
+}
+.clock-page-hero {
+  display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem;
+  padding: 1.15rem 1.25rem; border-radius: 1.25rem;
+  border: 1px solid #99f6e4;
+  background:
+    radial-gradient(90% 120% at 0% 0%, rgba(45,212,191,.18), transparent 55%),
+    linear-gradient(135deg, #ecfdf5 0%, #f0fdfa 45%, #fff 100%);
+  box-shadow: 0 18px 40px -30px rgba(15,118,110,.5);
+}
+.clock-page-hero__eyebrow {
+  display: inline-flex; align-items: center; gap: .45rem;
+  font-size: .68rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: #0f766e;
+}
+.clock-page-hero__eyebrow .pulse-dot,
+.clock-kiosk__eyebrow .pulse-dot {
+  width: .55rem; height: .55rem; border-radius: 999px; background: #14b8a6;
+  box-shadow: 0 0 0 0 rgba(20,184,166,.45); animation: pulse 1.8s infinite;
+}
+@keyframes pulse {
+  0% { box-shadow: 0 0 0 0 rgba(20,184,166,.45); }
+  70% { box-shadow: 0 0 0 8px rgba(20,184,166,0); }
+  100% { box-shadow: 0 0 0 0 rgba(20,184,166,0); }
+}
+.clock-page-hero__title {
+  margin: .35rem 0 0; font-size: clamp(1.6rem, 3vw, 2rem); font-weight: 800; letter-spacing: -0.03em;
+  color: #042f2e; line-height: 1.1;
+}
+.clock-page-hero__sub {
+  margin: .35rem 0 0; font-size: .9rem; font-weight: 500; color: #0f766e;
+}
+.clock-me-banner {
+  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .85rem;
+  padding: 1rem 1.15rem;
+  border-radius: 1.1rem;
+  border: 1px solid #99f6e4;
+  background: linear-gradient(135deg, #ecfdf5 0%, #f0fdfa 55%, #fff 100%);
+  box-shadow: 0 12px 28px -22px rgba(15,118,110,.55);
+}
+.clock-me-banner__eyebrow {
+  font-size: .65rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: #0f766e;
+}
+.clock-me-banner__name {
+  font-size: 1.15rem; font-weight: 800; color: #042f2e; letter-spacing: -0.02em; line-height: 1.2;
+}
+.clock-me-banner__pin {
+  margin-top: .2rem; font-size: .85rem; font-weight: 600; color: #115e59;
+}
+.clock-me-banner__pin b {
+  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
+  font-size: 1.05rem; letter-spacing: .12em; color: #042f2e;
+}
+.clock-pin-chip--me {
+  outline: 2px solid rgba(45,212,191,.85);
+  box-shadow: 0 0 0 3px rgba(13,148,136,.2);
+}
+.clock-kiosk {
+  position: relative;
+  overflow: hidden;
+  border: 1px solid rgba(94,234,212,.22);
+  background:
+    radial-gradient(120% 80% at 10% -10%, rgba(45,212,191,.28), transparent 55%),
+    radial-gradient(90% 70% at 100% 100%, rgba(13,148,136,.35), transparent 50%),
+    linear-gradient(165deg, #0b1220 0%, #0f766e 52%, #042f2e 100%);
+  color: #ecfdf5;
+  box-shadow:
+    0 24px 50px -28px rgba(4,47,46,.65),
+    inset 0 1px 0 rgba(255,255,255,.08);
+  animation: clock-rise .45s ease both;
+}
+.clock-kiosk::before {
+  content: '';
+  position: absolute; inset: 0;
+  background-image:
+    linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
+  background-size: 28px 28px;
+  mask-image: linear-gradient(180deg, rgba(0,0,0,.55), transparent 75%);
+  pointer-events: none;
+}
+.clock-kiosk > * { position: relative; z-index: 1; }
+@keyframes clock-rise {
+  from { opacity: 0; transform: translateY(10px) scale(.985); }
+  to { opacity: 1; transform: none; }
+}
+.clock-kiosk__eyebrow {
+  display: inline-flex; align-items: center; gap: .45rem;
+  font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
+  color: #99f6e4; margin-bottom: .65rem;
+}
+.clock-kiosk__site {
+  font-size: .82rem; font-weight: 600; color: rgba(236,253,245,.72); margin-bottom: .35rem;
+}
+.clock-live-time {
+  font-size: clamp(2.6rem, 6vw, 3.4rem); font-weight: 800; letter-spacing: -0.04em;
+  color: #fff; font-variant-numeric: tabular-nums; line-height: 1;
+  text-shadow: 0 8px 30px rgba(0,0,0,.35);
+}
+.clock-live-date {
+  margin-top: .4rem; font-size: .78rem; font-weight: 500; letter-spacing: .04em;
+  color: rgba(204,251,241,.7);
+}
+.clock-pin-slots {
+  display: flex; justify-content: center; gap: .65rem; margin: 1.15rem 0 1rem;
+}
+.clock-pin-slot {
+  width: 2.55rem; height: 3.1rem; border-radius: .85rem;
+  border: 1px solid rgba(153,246,228,.28);
+  background: rgba(4,47,46,.45);
+  box-shadow: inset 0 1px 0 rgba(255,255,255,.06);
+  display: flex; align-items: center; justify-content: center;
+  transition: border-color .15s, box-shadow .15s, transform .15s;
+}
+.clock-pin-slot.is-filled {
+  border-color: rgba(45,212,191,.75);
+  box-shadow: 0 0 0 3px rgba(20,184,166,.2), inset 0 1px 0 rgba(255,255,255,.1);
+  transform: translateY(-1px);
+}
+.clock-pin-slot__dot {
+  width: .7rem; height: .7rem; border-radius: 999px; background: #2dd4bf;
+  box-shadow: 0 0 12px rgba(45,212,191,.7);
+  transform: scale(0); transition: transform .12s ease;
+}
+.clock-pin-slot.is-filled .clock-pin-slot__dot { transform: scale(1); }
+.clock-pad {
+  display: grid; grid-template-columns: repeat(3, 1fr); gap: .55rem;
+  max-width: 17.5rem; margin: 0 auto 1rem;
+}
+.clock-pad-key {
+  height: 3.35rem; border-radius: 1rem;
+  border: 1px solid rgba(255,255,255,.1);
+  background: linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,.04));
+  backdrop-filter: blur(8px);
+  font-family: inherit; font-weight: 700; font-size: 1.2rem; color: #f0fdfa;
+  transition: transform .1s, background .15s, border-color .15s, box-shadow .15s;
+  box-shadow: 0 8px 16px -12px rgba(0,0,0,.55);
+}
+.clock-pad-key:hover {
+  background: linear-gradient(180deg, rgba(45,212,191,.28), rgba(13,148,136,.18));
+  border-color: rgba(94,234,212,.45);
+}
+.clock-pad-key:active {
+  transform: scale(.96);
+  box-shadow: 0 0 0 3px rgba(20,184,166,.25);
+}
+.clock-pad-key--muted { color: #99f6e4; font-size: .85rem; letter-spacing: .06em; }
+.clock-cta {
+  width: 100%;
+  display: inline-flex; align-items: center; justify-content: center; gap: .55rem;
+  padding: .95rem 1.1rem; border-radius: 1rem; border: 0;
+  font-family: inherit; font-weight: 700; font-size: .95rem; letter-spacing: .02em;
+  color: #042f2e;
+  background: linear-gradient(135deg, #5eead4 0%, #14b8a6 55%, #0d9488 100%);
+  box-shadow: 0 14px 28px -14px rgba(20,184,166,.85), inset 0 1px 0 rgba(255,255,255,.35);
+  transition: transform .12s, filter .12s;
+}
+.clock-cta:hover { filter: brightness(1.05); transform: translateY(-1px); }
+.clock-cta:active { transform: translateY(0); }
+.clock-kiosk__hint {
+  margin-top: .85rem; text-align: center; font-size: .7rem; color: rgba(204,251,241,.55);
+}
+.clock-kiosk.clock-kiosk--flash { animation: clock-flash .7s ease; }
+@keyframes clock-flash {
+  0% { box-shadow: 0 0 0 0 rgba(45,212,191,.0); }
+  35% { box-shadow: 0 0 0 6px rgba(45,212,191,.35), 0 24px 50px -28px rgba(4,47,46,.65); }
+  100% { box-shadow: 0 24px 50px -28px rgba(4,47,46,.65); }
+}
+.clock-side-panel {
+  border: 1px solid #d1fae5;
+  background: linear-gradient(180deg, rgba(240,253,250,.95), #fff 40%), #fff;
+  box-shadow: 0 18px 40px -30px rgba(15,118,110,.45);
+}
+.clock-stat {
+  border-radius: 1.1rem; padding: 1rem 1.1rem;
+  border: 1px solid #ccfbf1;
+  background: linear-gradient(160deg, #f0fdfa, #fff);
