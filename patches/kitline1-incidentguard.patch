+}
+.clock-log__head {
+  display: flex; align-items: center; justify-content: space-between; gap: .75rem;
+  padding: .95rem 1.1rem;
+  background: linear-gradient(90deg, #0f766e, #0d9488);
+  color: #ecfdf5;
+}
+.clock-log__head h3 { font-size: .95rem; font-weight: 700; margin: 0; display:flex; align-items:center; gap:.45rem; }
+.clock-log__body { padding: .35rem .85rem .85rem; max-height: 16rem; overflow: auto; }
+.clock-log-row {
+  display: grid; grid-template-columns: 1fr auto auto; gap: .75rem; align-items: center;
+  padding: .7rem .35rem; border-bottom: 1px solid #f1f5f9; font-size: .86rem;
