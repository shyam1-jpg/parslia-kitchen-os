+
+// Empty unless INCIDENT_REPORT_KEY is set — demo/public kiosks stay open by default.
+const PUBLIC_REPORT_KEY = (process.env.INCIDENT_REPORT_KEY || '').trim();
+
+function nextRef(state) {
+  const n = ((state.incidents || []).length + 1);
+  return 'IG-' + String(n).padStart(4, '0');
+}
+
+function normalizeIncident(inc) {
+  if (!inc || typeof inc !== 'object') return inc;
+  const map = {
+    Open: 'Reported',
+    'In progress': 'Action Required',
+    Closed: 'Closed',
+  };
+  if (map[inc.status]) inc.status = map[inc.status];
+  if (!inc.ref) inc.ref = nextRef({ incidents: [inc] });
+  if (!Array.isArray(inc.actions)) inc.actions = [];
+  if (!Array.isArray(inc.photos)) inc.photos = [];
+  if (!Array.isArray(inc.history)) inc.history = [];
+  if (!inc.investigation) {
+    inc.investigation = {
+      immediateCause: '', contributing: '', rootCause: '', fiveWhys: '',
+      existingControls: '', failedControls: '', lessons: '',
+    };
+  }
+  if (!Array.isArray(inc.feedback)) inc.feedback = [];
+  if (!Array.isArray(inc.links)) inc.links = [];
+  return inc;
+}
+
+function mayNeedRiddor(inc) {
+  const sev = String(inc.severity || '');
+  const cat = String(inc.category || inc.type || '').toLowerCase();
+  if (sev === 'Critical' || sev === 'High') {
+    if (/accident|injur|burn|cut|slip|fall|poison|fire|gas|chemical/.test(cat)) return true;
+  }
+  return !!inc.riddorFlag;
+}
+
+function createFromBody(state, body, meta) {
+  state.incidents = state.incidents || [];
+  const now = new Date().toISOString();
+  const photos = Array.isArray(body.photos) ? body.photos.slice(0, 4).map((p) => String(p).slice(0, 900000)) : [];
+  if (body.photoData) photos.unshift(String(body.photoData).slice(0, 900000));
+  const inc = normalizeIncident({
+    id: 'inc_' + crypto.randomBytes(4).toString('hex'),
+    ref: nextRef(state),
+    title: String(body.title || 'Untitled incident').trim().slice(0, 160),
+    category: String(body.category || 'Near miss').trim().slice(0, 80),
+    type: String(body.category || body.type || 'Other').trim().slice(0, 80),
+    site: body.site || state.currentSite || (state.sites && state.sites[0] && state.sites[0].id) || '',
+    area: String(body.area || '').trim().slice(0, 80),
+    severity: ['Low', 'Medium', 'High', 'Critical'].includes(body.severity) ? body.severity : 'Medium',
+    description: String(body.description || '').trim().slice(0, 4000),
+    dangerPresent: !!body.dangerPresent,
+    immediateAction: String(body.immediateAction || '').trim().slice(0, 2000),
+    action: String(body.immediateAction || body.action || '').trim().slice(0, 2000),
+    peopleInvolved: String(body.peopleInvolved || '').trim().slice(0, 500),
+    witnesses: String(body.witnesses || '').trim().slice(0, 500),
+    firstAid: String(body.firstAid || '').trim().slice(0, 500),
+    equipment: String(body.equipment || '').trim().slice(0, 200),
+    foodAffected: String(body.foodAffected || '').trim().slice(0, 500),
+    photoNote: String(body.photoNote || '').trim().slice(0, 500),
+    voiceNote: String(body.voiceNote || '').trim().slice(0, 8000),
+    voiceAudio: body.voiceAudio ? String(body.voiceAudio).slice(0, 1200000) : '',
+    photos,
+    gps: body.gps && typeof body.gps === 'object' ? {
+      lat: Number(body.gps.lat) || null,
+      lng: Number(body.gps.lng) || null,
+      accuracy: Number(body.gps.accuracy) || null,
+      at: now,
+    } : null,
+    qrLocation: String(body.qrLocation || '').trim().slice(0, 40),
+    reportedBy: meta.reportedBy || 'anonymous',
+    reporterName: String(body.reporterName || meta.reporterName || 'Anonymous').trim().slice(0, 80),
+    reporterContact: String(body.reporterContact || '').trim().slice(0, 120),
+    anonymous: !!meta.anonymous,
+    at: now,
+    status: 'Reported',
+    actions: [],
+    investigation: {},
+    history: [{ at: now, by: meta.reportedBy || 'anonymous', note: meta.anonymous ? 'Anonymous / QR report' : 'Incident reported' }],
+    feedback: [],
+    links: Array.isArray(body.links) ? body.links.slice(0, 12) : [],
+    riddorFlag: false,
+    source: meta.source || 'app',
+  });
+  if (mayNeedRiddor(inc)) inc.riddorFlag = true;
+  state.incidents.unshift(inc);
+  return inc;
+}
+
+async function escalate(state, inc) {
+  const sev = String(inc.severity || 'Low');
+  const alert = {
+    id: 'al_ig_' + inc.id,
+    severity: sev === 'Critical' ? 'critical' : sev === 'High' ? 'high' : sev === 'Medium' ? 'medium' : 'low',
+    site: inc.site,
+    title: 'IncidentGuard ' + (inc.ref || '') + ': ' + (inc.title || 'Incident'),
+    detail: [inc.category, inc.area, (inc.description || '').slice(0, 180)].filter(Boolean).join(' · '),
+    at: inc.at || new Date().toISOString(),
+    status: 'open',
+    sensor: null,
+    incidentId: inc.id,
+  };
+  state.alerts = state.alerts || [];
+  state.alerts.unshift(alert);
+
+  // Dashboard always; email for Medium+; SMS for High/Critical when channels on
+  const wantEmail = sev === 'Medium' || sev === 'High' || sev === 'Critical';
+  const wantSms = sev === 'High' || sev === 'Critical';
+  const results = { alert: true, email: null, sms: null };
+  try {
+    if (wantEmail && wantSms) {
+      const both = await notify.notifyAlert(state, alert);
+      results.email = both.email;
+      results.sms = both.sms;
+    } else if (wantEmail) {
+      results.email = await notify.sendEmail(state, alert);
+    }
+  } catch (e) {
+    results.email = { error: e.message };
+  }
+  return results;
+}
+
+async function openaiJson(messages, apiKey) {
+  const key = (apiKey || OPENAI_KEY || '').trim();
+  if (!key) throw new Error('No OpenAI API key — enable Recipe AI / Incident AI in Settings');
+  const res = await fetch(`${OPENAI_BASE}/chat/completions`, {
+    method: 'POST',
+    headers: { Authorization: 'Bearer ' + key, 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      model: CHAT_MODEL,
+      messages,
+      temperature: 0.4,
+      response_format: { type: 'json_object' },
+    }),
+  });
+  let data = null;
+  try { data = await res.json(); } catch {}
+  if (!res.ok) {
+    throw new Error((data && data.error && data.error.message) || 'OpenAI request failed');
+  }
+  const text = data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content;
+  if (!text) throw new Error('Empty AI response');
+  return JSON.parse(text);
+}
+
+const SYSTEM = `You assist UK professional kitchen managers with IncidentGuard drafts.
+Never claim legal certainty. Never decide RIDDOR. Never close incidents.
+Return JSON only. Keep language clear for busy chefs.`;
+
+async function runAi(action, body, apiKey) {
+  const inc = body.incident || body;
+  const base = [
+    `Title: ${inc.title || ''}`,
+    `Category: ${inc.category || inc.type || ''}`,
+    `Severity: ${inc.severity || ''}`,
+    `Area: ${inc.area || ''}`,
+    `Description: ${inc.description || ''}`,
+    `Immediate action: ${inc.immediateAction || inc.action || ''}`,
+    `Voice note transcript: ${inc.voiceNote || ''}`,
+    `Equipment: ${inc.equipment || ''}`,
+    `Food affected: ${inc.foodAffected || ''}`,
+  ].join('\n');
+
+  if (action === 'summarise' || action === 'summarize') {
+    return openaiJson([
+      { role: 'system', content: SYSTEM },
+      { role: 'user', content: `Summarise this kitchen incident for managers.\n${base}\nReturn JSON { "summary": string, "risks": string[], "nextSteps": string[] }` },
+    ], apiKey);
+  }
+  if (action === 'root-cause') {
+    return openaiJson([
+      { role: 'system', content: SYSTEM },
+      { role: 'user', content: `Suggest investigation angles (draft only).\n${base}\nReturn JSON { "immediateCause": string, "contributing": string, "rootCause": string, "fiveWhys": string, "failedControls": string }` },
+    ], apiKey);
+  }
+  if (action === 'capa') {
+    return openaiJson([
+      { role: 'system', content: SYSTEM },
+      { role: 'user', content: `Suggest corrective/preventive actions.\n${base}\nReturn JSON { "actions": [ { "instructions": string, "priority": "Low|Medium|High|Critical", "days": number } ] }` },
+    ], apiKey);
+  }
+  if (action === 'toolbox') {
+    return openaiJson([
+      { role: 'system', content: SYSTEM },
+      { role: 'user', content: `Draft a 5-minute toolbox talk from this incident.\n${base}\nReturn JSON { "title": string, "talkingPoints": string[], "briefing": string }` },
+    ], apiKey);
+  }
+  if (action === 'translate') {
+    const lang = String(body.lang || 'es').slice(0, 20);
+    return openaiJson([
+      { role: 'system', content: SYSTEM },
+      { role: 'user', content: `Translate incident fields to ${lang}.\n${base}\nReturn JSON { "title": string, "description": string, "immediateAction": string, "lang": string }` },
+    ], apiKey);
+  }
+  if (action === 'structure-voice') {
+    const transcript = String(body.transcript || inc.voiceNote || '').trim();
+    if (!transcript) throw new Error('No transcript');
+    return openaiJson([
+      { role: 'system', content: SYSTEM },
+      { role: 'user', content: `Convert this kitchen voice note into a structured incident draft:\n${transcript}\nReturn JSON { "title": string, "category": string, "severity": "Low|Medium|High|Critical", "description": string, "immediateAction": string, "area": string }` },
+    ], apiKey);
+  }
+  throw new Error('Unknown Incident AI action');
+}
+
+function dashboardStats(state, siteId) {
+  const list = (state.incidents || []).map(normalizeIncident).filter((i) => !siteId || i.site === siteId);
+  const open = list.filter((i) => i.status !== 'Closed');
+  const byCat = {};
+  const byArea = {};
+  list.forEach((i) => {
+    const c = i.category || i.type || 'Other';
+    byCat[c] = (byCat[c] || 0) + 1;
+    const a = i.area || 'Unspecified';
+    byArea[a] = (byArea[a] || 0) + 1;
+  });
+  let overdue = 0;
+  const today = new Date().toISOString().slice(0, 10);
+  list.forEach((i) => (i.actions || []).forEach((a) => {
+    if (a.status !== 'Completed' && a.due && a.due < today) overdue += 1;
+  }));
+  const closed = list.filter((i) => i.status === 'Closed' && i.closedAt);
+  let avgHours = null;
+  if (closed.length) {
+    const sum = closed.reduce((acc, i) => acc + (new Date(i.closedAt) - new Date(i.at)), 0);
+    avgHours = Math.round((sum / closed.length) / 36e5);
+  }
+  return {
+    total: list.length,
+    open: open.length,
+    critical: list.filter((i) => i.severity === 'Critical' || i.severity === 'High').length,
+    overdue,
+    allergen: list.filter((i) => /allergen/i.test(i.category || '')).length,
+    temperature: list.filter((i) => /fridge|freezer|temperature|hot-hold|cooking/i.test(i.category || '')).length,
+    byCategory: byCat,
+    byArea,
+    avgHoursToClose: avgHours,
+  };
+}
+
+function suggestKitchenLinks(state, siteId) {
+  const site = siteId || state.currentSite;
+  const sensors = (state.sensors || []).filter((s) => !site || s.siteId === site).slice(0, 8)
+    .map((s) => ({ kind: 'sensor', id: s.id, label: s.name, route: 'temps' }));
+  const assets = (state.assets || []).filter((a) => !site || a.site === site).slice(0, 8)
+    .map((a) => ({ kind: 'asset', id: a.id, label: a.name || a.id, route: 'assets' }));
+  const recipes = (state.recipes || []).filter((r) => !site || r.site === site).slice(0, 8)
+    .map((r) => ({ kind: 'recipe', id: r.id, label: r.name, route: 'recipes' }));
+  const deliveries = (state.deliveries || []).filter((d) => !site || d.site === site).slice(0, 6)
+    .map((d) => ({ kind: 'delivery', id: d.id, label: (d.supplier || 'Delivery') + ' · ' + (d.items || '').slice(0, 40), route: 'deliveries' }));
+  const batches = (state.batches || []).filter((b) => !site || b.site === site).slice(0, 6)
+    .map((b) => ({ kind: 'batch', id: b.id, label: (b.product || b.batchNo || b.id), route: 'batches' }));
