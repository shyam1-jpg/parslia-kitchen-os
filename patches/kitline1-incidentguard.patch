+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>Report an incident — Kiteline IncidentGuard</title>
+  <meta name="description" content="Submit a kitchen incident or near-miss without accessing management records." />
+  <script src="https://cdn.tailwindcss.com"></script>
+  <script>tailwind.config={theme:{extend:{colors:{brand:{500:'#14b8a6',600:'#0d9488',700:'#0f766e'},ink:{100:'#f1f5f9',400:'#94a3b8',500:'#64748b',700:'#334155',900:'#0f172a'}},fontFamily:{sans:['Source Sans 3','system-ui','sans-serif']}}}}</script>
+  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Sora:wght@700&display=swap" rel="stylesheet">
+  <style>
+    body{font-family:'Source Sans 3',system-ui,sans-serif}
+    .display{font-family:Sora,system-ui,sans-serif}
+    .hero{background:linear-gradient(155deg,#0b1220,#0f766e 55%,#042f2e)}
+  </style>
+</head>
+<body class="bg-ink-100 text-ink-900 antialiased min-h-screen">
+  <header class="hero text-white px-5 py-8">
+    <div class="max-w-lg mx-auto">
+      <p class="text-brand-300 text-xs font-bold tracking-widest uppercase">Kiteline IncidentGuard</p>
+      <h1 class="display text-2xl font-bold mt-2">Report an incident</h1>
+      <p class="text-white/70 text-sm mt-2">No management login required. Your report gets a reference number and goes to the kitchen register.</p>
+    </div>
+  </header>
+
+  <main class="max-w-lg mx-auto px-5 py-6">
+    <div id="okBox" class="hidden rounded-2xl bg-white border border-brand-200 p-5 mb-4">
+      <p class="font-bold text-brand-700">Report received</p>
+      <p class="text-sm text-ink-500 mt-1" id="okMsg"></p>
+      <a href="/incident-report.html" class="inline-block mt-3 text-brand-700 font-semibold text-sm">Submit another →</a>
+    </div>
+
+    <form id="form" class="bg-white rounded-2xl border border-ink-100 p-5 space-y-3 shadow-sm">
+      <input id="title" class="w-full rounded-lg border border-ink-100 px-3 py-2" placeholder="Short title *" required>
+      <div class="grid grid-cols-2 gap-2">
+        <select id="category" class="rounded-lg border border-ink-100 px-3 py-2 text-sm"></select>
+        <select id="severity" class="rounded-lg border border-ink-100 px-3 py-2 text-sm">
+          <option>Low</option><option selected>Medium</option><option>High</option><option>Critical</option>
+        </select>
+      </div>
+      <input id="area" class="w-full rounded-lg border border-ink-100 px-3 py-2" placeholder="Kitchen area">
+      <textarea id="description" class="w-full rounded-lg border border-ink-100 px-3 py-2" rows="4" placeholder="What happened *" required></textarea>
+      <label class="flex items-center gap-2 text-sm"><input type="checkbox" id="danger"> Danger still present</label>
+      <textarea id="immediateAction" class="w-full rounded-lg border border-ink-100 px-3 py-2" rows="2" placeholder="Immediate action taken"></textarea>
+      <input id="reporterName" class="w-full rounded-lg border border-ink-100 px-3 py-2" placeholder="Your name (optional)">
+      <input id="reporterContact" class="w-full rounded-lg border border-ink-100 px-3 py-2" placeholder="Email or mobile for feedback (optional)">
+      <div>
+        <label class="text-xs font-semibold text-ink-500">Photo evidence</label>
+        <input id="photo" type="file" accept="image/*" capture="environment" class="block w-full text-sm mt-1">
+        <img id="photoPrev" class="hidden mt-2 rounded-lg max-h-40" alt="">
+      </div>
+      <div class="flex flex-wrap gap-2">
+        <button type="button" id="btnGps" class="px-3 py-2 rounded-lg bg-ink-100 text-sm font-semibold">Add GPS</button>
+        <button type="button" id="btnVoice" class="px-3 py-2 rounded-lg bg-ink-100 text-sm font-semibold">Voice note (8s)</button>
+        <span id="gpsLabel" class="text-xs text-ink-400 self-center"></span>
+      </div>
+      <textarea id="voiceNote" class="w-full rounded-lg border border-ink-100 px-3 py-2 text-sm" rows="2" placeholder="Voice transcript / notes"></textarea>
+      <p id="err" class="text-sm text-red-600 hidden"></p>
+      <p id="offlineNote" class="text-xs text-amber-700 hidden">You appear offline — this report will queue on this device and sync when online.</p>
+      <button type="submit" class="w-full py-3 rounded-xl bg-brand-600 text-white font-bold">Submit report</button>
+    </form>
+    <p class="text-center text-xs text-ink-400 mt-6"><a class="underline" href="/incident-management.html">About IncidentGuard</a> · <a class="underline" href="/app">Staff sign-in</a></p>
+  </main>
+
+  <script>
+    const CATS = ['Near miss','Accident or injury','Burn, cut, slip or fall','Unsafe condition','Allergen incident','Foreign object','Food contamination','Suspected food poisoning','Fridge or freezer failure','Cooking or hot-holding failure','Equipment breakdown','Pest sighting','Chemical spill','Fire or gas incident','Customer complaint','Supplier recall','Other'];
+    const catEl = document.getElementById('category');
+    CATS.forEach(c => { const o=document.createElement('option'); o.textContent=c; catEl.appendChild(o); });
+    const params = new URLSearchParams(location.search);
+    const qr = params.get('qr') || '';
+    const site = params.get('site') || '';
+    if (qr) {
+      document.getElementById('area').value = qr.replace(/_/g,' ');
+      document.getElementById('title').value = (qr.replace(/_/g,' ')) + ' incident';
+      catEl.value = 'Equipment breakdown';
+    }
+    let photoData = '';
+    let gps = null;
+    let voiceAudio = '';
+    document.getElementById('photo').onchange = (e) => {
+      const f = e.target.files && e.target.files[0];
+      if (!f) return;
+      const reader = new FileReader();
+      reader.onload = () => {
+        const img = new Image();
+        img.onload = () => {
+          const max=700; let w=img.width,h=img.height;
+          if (w>max){ h=Math.round(h*max/w); w=max; }
+          const c=document.createElement('canvas'); c.width=w; c.height=h;
+          c.getContext('2d').drawImage(img,0,0,w,h);
+          photoData = c.toDataURL('image/jpeg', 0.75);
+          const prev=document.getElementById('photoPrev');
+          prev.src=photoData; prev.classList.remove('hidden');
+        };
+        img.src = reader.result;
+      };
+      reader.readAsDataURL(f);
+    };
+    document.getElementById('btnGps').onclick = () => {
+      if (!navigator.geolocation) { document.getElementById('gpsLabel').textContent='GPS not available'; return; }
+      navigator.geolocation.getCurrentPosition((p)=>{
+        gps={ lat:p.coords.latitude, lng:p.coords.longitude, accuracy:p.coords.accuracy };
+        document.getElementById('gpsLabel').textContent = gps.lat.toFixed(4)+', '+gps.lng.toFixed(4);
+      }, ()=>{ document.getElementById('gpsLabel').textContent='GPS denied'; }, { timeout:8000 });
+    };
+    document.getElementById('btnVoice').onclick = async () => {
+      const btn=document.getElementById('btnVoice');
+      try {
+        btn.disabled=true; btn.textContent='Recording…';
+        const stream = await navigator.mediaDevices.getUserMedia({ audio:true });
+        const rec = new MediaRecorder(stream);
+        const chunks=[];
+        rec.ondataavailable = e => chunks.push(e.data);
+        const done = new Promise(res => { rec.onstop = () => {
+          stream.getTracks().forEach(t=>t.stop());
+          const blob=new Blob(chunks,{type:rec.mimeType||'audio/webm'});
+          const r=new FileReader(); r.onload=()=>res(r.result); r.readAsDataURL(blob);
+        };});
+        rec.start();
+        await new Promise(r=>setTimeout(r,8000));
+        if (rec.state!=='inactive') rec.stop();
+        voiceAudio = await done;
+        btn.textContent='Voice saved';
+        // optional browser STT
+        const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
+        if (SR) {
+          const s=new SR(); s.lang='en-GB';
+          s.onresult=(ev)=>{ document.getElementById('voiceNote').value = ev.results[0][0].transcript; };
+          try { s.start(); } catch {}
+        }
+      } catch (e) {
+        btn.textContent='Mic blocked';
+        document.getElementById('err').textContent = e.message || 'Microphone failed';
+        document.getElementById('err').classList.remove('hidden');
+      } finally { setTimeout(()=>{ btn.disabled=false; if(btn.textContent==='Recording…') btn.textContent='Voice note (8s)'; }, 500); }
+    };
+
+    const QUEUE_KEY='kiteline.ig.publicQueue';
+    function queue(report){
+      const q=JSON.parse(localStorage.getItem(QUEUE_KEY)||'[]'); q.push(report);
+      localStorage.setItem(QUEUE_KEY, JSON.stringify(q.slice(-40)));
+    }
+    async function flush(){
+      const q=JSON.parse(localStorage.getItem(QUEUE_KEY)||'[]'); if(!q.length) return;
+      const left=[];
+      for (const item of q){
+        try {
+          const res=await fetch('/api/incidents/public-report',{ method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(item)});
+          if(!res.ok) throw new Error('fail');
+        } catch { left.push(item); }
+      }
+      localStorage.setItem(QUEUE_KEY, JSON.stringify(left));
+    }
+    flush();
+    window.addEventListener('online', flush);
+
+    document.getElementById('form').onsubmit = async (e) => {
+      e.preventDefault();
+      const err=document.getElementById('err'); err.classList.add('hidden');
+      const body = {
+        title: document.getElementById('title').value.trim(),
+        category: document.getElementById('category').value,
+        severity: document.getElementById('severity').value,
+        area: document.getElementById('area').value.trim(),
+        description: document.getElementById('description').value.trim(),
+        dangerPresent: document.getElementById('danger').checked,
+        immediateAction: document.getElementById('immediateAction').value.trim(),
+        reporterName: document.getElementById('reporterName').value.trim(),
+        reporterContact: document.getElementById('reporterContact').value.trim(),
+        photoData, photos: photoData ? [photoData] : [],
+        gps, voiceNote: document.getElementById('voiceNote').value.trim(), voiceAudio,
+        qrLocation: qr, site: site || undefined,
+      };
+      if (!body.title || !body.description) { err.textContent='Title and description required'; err.classList.remove('hidden'); return; }
+      try {
+        if (!navigator.onLine) throw new Error('offline');
+        const res = await fetch('/api/incidents/public-report', {
+          method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)
+        });
+        const data = await res.json().catch(()=>({}));
+        if (!res.ok) throw new Error(data.error || 'Submit failed');
+        document.getElementById('form').classList.add('hidden');
+        document.getElementById('okBox').classList.remove('hidden');
+        document.getElementById('okMsg').textContent = 'Reference ' + (data.ref || data.incident && data.incident.ref) + '. Thank you — a manager will review this.';
+      } catch (ex) {
+        queue(body);
+        document.getElementById('offlineNote').classList.remove('hidden');
+        document.getElementById('form').classList.add('hidden');
+        document.getElementById('okBox').classList.remove('hidden');
+        document.getElementById('okMsg').textContent = 'Saved on this device. It will sync automatically when the connection returns.';
+      }
+    };
+  </script>
+</body>
+</html>
