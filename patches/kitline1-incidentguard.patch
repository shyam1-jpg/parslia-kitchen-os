+const OPENAI_KEY = (process.env.OPENAI_API_KEY || '').trim();
+const OPENAI_BASE = (process.env.OPENAI_BASE_URL || 'https://api.openai.com/v1').replace(/\/$/, '');
+const CHAT_MODEL = process.env.OPENAI_MODEL || 'gpt-4o-mini';
