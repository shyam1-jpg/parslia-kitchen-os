+    'amy chen': '5678', 'shyam prasad': '1001',
+  };
+
+  function demoClockPinFor(member) {
+    if (!member) return '';
+    if (DEMO_CLOCK_PINS[member.id]) return DEMO_CLOCK_PINS[member.id];
+    const email = String(member.email || '').toLowerCase().trim();
+    if (email && DEMO_CLOCK_PINS_BY_EMAIL[email]) return DEMO_CLOCK_PINS_BY_EMAIL[email];
+    const name = String(member.name || '').toLowerCase().replace(/\s*\(sample\)\s*$/, '').trim();
+    return DEMO_CLOCK_PINS_BY_NAME[name] || '';
+  }
+
+  function rotaRestoreDemoPins(db) {
+    (db.team || []).forEach((m, idx) => {
+      const demo = demoClockPinFor(m);
+      if (demo) m.clockPin = demo;
+      else if (!normalizeClockPin(m.clockPin || m.pin)) {
+        m.clockPin = String(1000 + ((idx + 1) * 111) % 9000).padStart(4, '0').slice(0, 4);
+      }
+    });
   }
 
