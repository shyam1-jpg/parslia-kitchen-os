+  /** Ensure every site has its own workflow pack (fixes kitchen switcher showing Grove-only data). */
+  function ensureWorkflowsForAllSites(db) {
+    if (!db || !Array.isArray(db.workflows) || !Array.isArray(db.sites)) return false;
+    const counts = {};
+    db.workflows.forEach((w) => { counts[w.site] = (counts[w.site] || 0) + 1; });
+    let changed = false;
+    db.sites.forEach((site) => {
+      const n = counts[site.id] || 0;
+      if (n >= 30) return;
+      const pack = seedWorkflows(site.id);
+      const size = ['site_grove', 'site_dock', 'site_vedanta', 'site_govindas', 'site_quay'].includes(site.id) ? pack.length : 40;
+      const next = pack.slice(0, size);
+      db.workflows = db.workflows.filter((w) => w.site !== site.id).concat(next);
+      counts[site.id] = next.length;
+      changed = true;
+    });
+    if (changed) db._workflowsPerSite = 1;
+    return changed;
+  }
