+/* Clock In / Out kiosk */
+.clock-kiosk { background:linear-gradient(180deg,#f0fdfa 0%,#ffffff 55%); }
+.clock-live-time { font-size:2.75rem; font-weight:800; letter-spacing:-0.03em; color:#0f766e; font-variant-numeric:tabular-nums; line-height:1; }
+.clock-pin-display {
+  font-size:1.75rem; font-weight:700; letter-spacing:.45em; text-align:center;
+  padding:.75rem 1rem; border-radius:.85rem; background:#fff; border:1px solid #d1fae5;
+  color:#0f766e; min-height:3.25rem;
+}
+.clock-pad { display:grid; grid-template-columns:repeat(3,1fr); gap:.5rem; max-width:16rem; margin:0 auto; }
+.clock-pad-key {
+  height:3.1rem; border-radius:.8rem; border:1px solid #e2e8f0; background:#fff;
+  font-weight:700; font-size:1.15rem; color:#0f172a; transition:background .12s, transform .08s;
+}
+.clock-pad-key:hover { background:#f8fafc; }
+.clock-pad-key:active { transform:scale(.97); background:#ecfdf5; }
+.clock-staff-card {
+  background:#fff; border:1px solid #e9eef5; border-radius:1rem; padding:1rem;
+  transition:border-color .15s, box-shadow .15s;
+}
+.clock-staff-card:hover { border-color:#99f6e4; box-shadow:0 8px 20px -14px rgba(15,118,110,.45); }
+.clock-staff-card--in { border-color:#6ee7b7; background:#f0fdf4; }
+
+/* header notifications dropdown */
+.notif-wrap { position:relative; }
+.notif-panel {
+  position:absolute; right:0; top:calc(100% + .5rem); width:min(22rem, calc(100vw - 2rem));
+  background:#fff; border:1px solid #e2e8f0; border-radius:.9rem;
+  box-shadow:0 18px 40px -18px rgba(15,23,42,.35); z-index:80; overflow:hidden;
+}
+.notif-panel.hidden { display:none; }
+.notif-item { display:flex; gap:.75rem; padding:.85rem 1rem; border-bottom:1px solid #f1f5f9; text-align:left; width:100%; background:#fff; }
+.notif-item:hover { background:#f8fafc; }
+.notif-item:last-child { border-bottom:0; }
+
 /* layout */
 .app-shell { display: grid; grid-template-columns: var(--side) 1fr; min-height: 100vh; }
 .mobile-nav-btn { display: none; }
