+  display:inline-block; background:#94a3b8; box-shadow:0 0 0 2px rgba(148,163,184,.2);
+}
+.wf-dot--green { background:#16a34a; box-shadow:0 0 0 2px rgba(22,163,74,.18); }
+.wf-dot--amber { background:#d97706; box-shadow:0 0 0 2px rgba(217,119,6,.18); }
