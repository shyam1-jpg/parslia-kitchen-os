+/* ============================================================
+   Kiteline — How-to guides (where to click, what to enter)
+   Used by User Manual and contextual help panels.
+   ============================================================ */
+(function () {
+  const GUIDES = [
+    {
+      id: 'clock-pin',
+      title: 'Employee clock in / out (kitchen PIN)',
+      icon: 'clock',
+      tags: ['clock', 'pin', 'staff', 'login'],
+      summary: 'Use a 4-digit clock PIN — not your website login password.',
+      route: 'clock',
+      steps: [
+        'Open the left menu → Clock In/Out (under Live Ops). If you do not see it, ask an Admin — your role may be Staff-only for other pages.',
+        'Find your name on the staff cards, or type the 4-digit PIN on the pad / chips (when shown).',
+        'Enter the 4-digit kitchen clock PIN shown on the staff card / demo chips — not your website login password.',
+        'Demo PINs (Grove): Sarah 1234, James 2345, Lena 3456, Marco 4567. Owner (Vedanta) 1001. Priya 1111, James (Vedanta) 2222, Marco (Vedanta) 3333.',
+        'Wrong PIN almost always means you typed the login password (e.g. demo1234). That password opens the website; the clock needs the 4-digit PIN only.',
+        'Admins can edit PINs on Team → PIN column. After changing a PIN, use the new code on Clock In/Out.',
+        'You should see “clocked in” or “clocked out” and the live time update.',
+      ],
+      tips: [
+        'Signed in as Admin/Manager? Use “Clock me in” at the top of Clock In/Out to skip typing a PIN for yourself.',
+        'Rota (menu → Rota & Shifts) shows who is scheduled; Clock In/Out is for attendance.',
+        'Switch the site at the top bar first — PINs and staff lists are per kitchen.',
+      ],
+    },
+    {
+      id: 'freezer-temps',
+      title: 'Fridge & freezer temperatures',
+      icon: 'temp',
+      tags: ['fridge', 'freezer', 'temperature', 'temps'],
+      summary: 'Where live probe readings appear and how alerts work.',
+      route: 'temps',
+      steps: [
+        'Open Fridge & Freezer Temps from the left menu (Live Ops / monitoring area).',
+        'Each card is a sensor (fridge, freezer, hot hold). Green = in range; red/amber = out of range.',
+        'Live temperatures update from probes (or demo simulation). Tap a sensor for history charts when available.',
+        'For SMS/email when a fridge goes out of range → open Alerts & SMS and check notification settings.',
+        'Manual cooking / cooling logs are under Records, Cooling, and Hot & Cold Hold — not the same as live fridge probes.',
+      ],
+      tips: [
+        'Site switcher (top) must match the kitchen you are checking — sensors are per site.',
+      ],
+    },
+    {
+      id: 'probe-calibration',
+      title: 'Probe calibration (ice / boiling check)',
+      icon: 'temp',
+      tags: ['probe', 'calibration', 'coloration', 'ice', 'boiling'],
+      summary: 'Record ice 0°C and boiling ~100°C checks for handheld probes.',
+      route: 'compliance-probeCalibration',
+      steps: [
+        'Open Kitchen Compliance from the left menu.',
+        'Choose the Probe Calibration tab (or go to #compliance-probeCalibration).',
+        'Open an existing sample record with View full record, or add a new calibration.',
+        'Enter ice reading (target 0°C), boiling reading (target 100°C), any adjustment, and next due date.',
+        'Print the record for your EHO folder using Print on the compliance header or on the record.',
+      ],
+      tips: [
+        '“Crop coloration” is not a menu name — if you meant probe calibration, use this guide. Colour / presentation checks can live in HACCP checklists.',
+      ],
+    },
+    {
+      id: 'equipment-maintenance',
+      title: 'Equipment maintenance records (PPM)',
+      icon: 'wrench',
+      tags: ['equipment', 'maintenance', 'ppm', 'service', 'khs'],
