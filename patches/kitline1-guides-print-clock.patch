+/* ---------- Clock In/Out kiosk ---------- */
+.clock-live-time {
+  font-size: 2.75rem; font-weight: 800; letter-spacing: -0.03em;
+  color: #0f766e; font-variant-numeric: tabular-nums; line-height: 1;
+}
+.clock-pin-slots {
+  display: flex; gap: .55rem; justify-content: center; margin: .85rem 0 1rem;
+}
+.clock-pin-slot {
+  width: 2.6rem; height: 3rem; border-radius: .75rem;
+  border: 2px solid #99f6e4; background: #f0fdfa;
+  display: flex; align-items: center; justify-content: center;
+  transition: border-color .12s, background .12s, box-shadow .12s;
+}
+.clock-pin-slot.is-filled {
+  border-color: #0d9488; background: #ccfbf1;
+  box-shadow: 0 0 0 3px rgba(13,148,136,.15);
+}
+.clock-pin-slot.is-filled::after {
+  content: ''; width: .7rem; height: .7rem; border-radius: 999px; background: #0f766e;
+}
+.clock-pad {
+  display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem;
+  max-width: 16rem; margin: 0 auto;
+}
+.clock-pad-key {
+  height: 3rem; border-radius: .85rem; border: 1px solid #e2e8f0;
+  background: #fff; font-size: 1.15rem; font-weight: 700; color: #0f172a;
+  cursor: pointer; font-family: inherit;
+  transition: background .12s, transform .08s;
+}
+.clock-pad-key:hover { background: #f8fafc; }
+.clock-pad-key:active { transform: scale(.97); background: #ecfdf5; }
+.clock-pad-key--muted { color: #64748b; font-size: .85rem; letter-spacing: .04em; }
+.clock-staff-card {
+  border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1rem;
+  background: #fff; transition: border-color .15s, box-shadow .15s;
+}
+.clock-staff-card:hover { border-color: #99f6e4; box-shadow: 0 8px 20px -14px rgba(15,118,110,.45); }
+.clock-staff-card--in { border-color: #6ee7b7; background: #f0fdf4; }
+.clock-staff-pin {
+  margin-top: .7rem; padding: .4rem .55rem; border-radius: .65rem;
+  background: #f0fdfa; border: 1px dashed #99f6e4;
+  font-size: .72rem; font-weight: 600; color: #0f766e; text-align: center;
+}
+.clock-staff-pin b {
+  font-variant-numeric: tabular-nums; letter-spacing: .14em; color: #115e59; margin-left: .25rem;
+}
+.clock-pin-cheatsheet {
+  margin-top: 1rem; padding-top: .9rem; border-top: 1px solid #e2e8f0;
+}
+.clock-pin-cheatsheet__title {
+  text-align: center; font-size: .65rem; font-weight: 700;
+  letter-spacing: .12em; text-transform: uppercase; color: #64748b;
+  margin-bottom: .55rem;
+}
+.clock-pin-cheatsheet__rows {
+  display: flex; flex-wrap: wrap; gap: .4rem; justify-content: center;
+}
+.clock-pin-chip {
+  display: inline-flex; align-items: center; gap: .4rem;
+  padding: .4rem .65rem; border-radius: 999px; cursor: pointer;
+  border: 1px solid #99f6e4; background: #f0fdfa; color: #134e4a;
+  font-size: .72rem; font-weight: 600; font-family: inherit;
+  transition: background .12s, border-color .12s, transform .1s;
+}
+.clock-pin-chip b {
+  font-variant-numeric: tabular-nums; letter-spacing: .12em;
+  color: #0f766e; font-weight: 800;
+}
+.clock-pin-chip:hover {
+  background: #ccfbf1; border-color: #5eead4; transform: translateY(-1px);
+}
+.clock-pin-chip--me { border-color: #0d9488; background: #ccfbf1; }
+.clock-kiosk { background: linear-gradient(180deg, #f0fdfa 0%, #ffffff 55%); }
+.howto-panel summary { list-style: none; }
+.howto-panel summary::-webkit-details-marker { display: none; }
